{
  "type": "View",
  "id": "cg_route_root",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "wrapContent",
  "child": [
    {
      "type": "Button",
      "id": "cg_route_go_flow",
      "text": "cg flow go 6",
      "onClick": "@{onFlowIndex}"
    },
    {
      "type": "Collection",
      "id": "cg_route_flow",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{ruleRows}",
      "sections": [
        {
          "cell": "conformance_cell",
          "header": "conformance_cell",
          "footer": "conformance_cell"
        },
        {
          "cell": "conformance_cell",
          "header": "conformance_cell"
        }
      ],
      "layout": "flow",
      "scrollTo": "@{flowIndex}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    },
    {
      "type": "Button",
      "id": "cg_route_go_flow_key",
      "text": "cg flow go k3",
      "onClick": "@{onFlowKey}"
    },
    {
      "type": "Collection",
      "id": "cg_route_flow_key",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{ruleKeyed}",
      "sections": [
        {
          "cell": "conformance_cell"
        },
        {
          "cell": "conformance_cell"
        }
      ],
      "layout": "flow",
      "cellIdProperty": "key",
      "scrollTo": "@{flowKey}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    },
    {
      "type": "Button",
      "id": "cg_route_go_list",
      "text": "cg list go 6",
      "onClick": "@{onListIndex}"
    },
    {
      "type": "Collection",
      "id": "cg_route_list",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{ruleRows}",
      "sections": [
        {
          "cell": "conformance_cell",
          "header": "conformance_cell",
          "footer": "conformance_cell"
        },
        {
          "cell": "conformance_cell",
          "header": "conformance_cell"
        }
      ],
      "listStyle": "plain",
      "scrollTo": "@{listIndex}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    },
    {
      "type": "Button",
      "id": "cg_route_go_list_key",
      "text": "cg list go k3",
      "onClick": "@{onListKey}"
    },
    {
      "type": "Collection",
      "id": "cg_route_list_key",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{ruleKeyed}",
      "sections": [
        {
          "cell": "conformance_cell"
        },
        {
          "cell": "conformance_cell"
        }
      ],
      "listStyle": "plain",
      "cellIdProperty": "key",
      "scrollTo": "@{listKey}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    },
    {
      "type": "Collection",
      "id": "cg_route_initial",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{ruleRows}",
      "sections": [
        {
          "cell": "conformance_cell",
          "header": "conformance_cell",
          "footer": "conformance_cell"
        },
        {
          "cell": "conformance_cell",
          "header": "conformance_cell"
        }
      ],
      "scrollTo": "@{initialIndex}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    }
  ],
