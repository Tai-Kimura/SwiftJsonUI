{
  "type": "View",
  "id": "cg_route3_root",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "wrapContent",
  "child": [
    {
      "type": "Button",
      "id": "cg_route_go_int_list",
      "text": "cg int list go 12",
      "onClick": "@{onIntList}"
    },
    {
      "type": "Collection",
      "id": "cg_route_int_list",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{keyedRows}",
      "sections": [
        {
          "cell": "conformance_cell"
        },
        {
          "cell": "conformance_cell"
        }
      ],
      "cellIdProperty": "key",
      "scrollTo": "@{intList}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    },
    {
      "type": "Button",
      "id": "cg_route_go_int_class",
      "text": "cg int class go 12",
      "onClick": "@{onIntClass}"
    },
    {
      "type": "Collection",
      "id": "cg_route_int_class",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{keyedRows}",
      "cellClasses": [
        "conformance_cell"
      ],
      "cellIdProperty": "key",
      "scrollTo": "@{intClass}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    },
    {
      "type": "Button",
      "id": "cg_route_go_int_pager",
      "text": "cg int pager go 12",
      "onClick": "@{onIntPager}"
    },
    {
      "type": "Collection",
      "id": "cg_route_int_pager",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{keyedRows}",
      "sections": [
        {
          "cell": "conformance_cell"
        },
        {
          "cell": "conformance_cell"
        }
      ],
      "layout": "horizontal",
      "paging": true,
      "cellIdProperty": "key",
      "scrollTo": "@{intPager}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    },
    {
      "type": "Button",
      "id": "cg_route_go_dup_k",
      "text": "cg dup go k",
      "onClick": "@{onDupK}"
    },
    {
      "type": "Button",
      "id": "cg_route_go_dup_3",
      "text": "cg dup go 3",
      "onClick": "@{onDup3}"
    },
    {
      "type": "Button",
      "id": "cg_route_go_dup_w5",
      "text": "cg dup go w5",
      "onClick": "@{onDupW5}"
    },
    {
      "type": "Collection",
      "id": "cg_route_dup",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{dupRows}",
      "sections": [
        {
          "cell": "conformance_cell"
        },
        {
          "cell": "conformance_cell"
        }
      ],
      "cellIdProperty": "key",
      "scrollTo": "@{dupKey}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    }
  ],
