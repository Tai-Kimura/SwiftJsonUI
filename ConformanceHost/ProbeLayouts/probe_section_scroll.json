{
  "type": "View",
  "id": "cg_scroll_root",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "wrapContent",
  "child": [
    {
      "type": "Button",
      "id": "cg_go_index",
      "text": "go index",
      "onClick": "@{onScrollIndex}"
    },
    {
      "type": "Collection",
      "id": "cg_scroll_index",
      "width": 200,
      "height": 112,
      "background": "#DDDDDD",
      "items": "@{rows}",
      "sections": [
        {
          "cell": "conformance_cell"
        },
        {
          "cell": "conformance_cell"
        }
      ],
      "scrollTo": "@{scrollIndex}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    },
    {
      "type": "Button",
      "id": "cg_go_key",
      "text": "go key",
      "onClick": "@{onScrollKey}"
    },
    {
      "type": "Collection",
      "id": "cg_scroll_key",
      "width": 200,
      "height": 112,
      "background": "#DDDDDD",
      "items": "@{keyed}",
      "sections": [
        {
          "cell": "conformance_cell"
        },
        {
          "cell": "conformance_cell"
        }
      ],
      "cellIdProperty": "key",
      "scrollTo": "@{scrollKey}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    },
    {
      "type": "Collection",
      "id": "cg_shared_keys",
      "width": 200,
      "height": 280,
      "background": "#DDDDDD",
