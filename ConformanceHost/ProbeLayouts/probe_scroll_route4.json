{
  "type": "View",
  "id": "cg_route4_root",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "wrapContent",
  "child": [
    {
      "type": "Button",
      "id": "cg_route_go_auto_raw",
      "text": "cg auto go k3",
      "onClick": "@{onAutoRaw}"
    },
    {
      "type": "Button",
      "id": "cg_route_go_auto_enriched",
      "text": "cg auto go k3~",
      "onClick": "@{onAutoEnriched}"
    },
    {
      "type": "Collection",
      "id": "cg_route_auto_list",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{keyedRows}",
      "cellIdProperty": "key",
      "autoChangeTrackingId": true,
      "scrollTo": "@{autoKey}",
      "scrollAnchor": "top",
      "scrollAnimated": false,
      "sections": [
        {
          "cell": "conformance_cell"
        },
        {
          "cell": "conformance_cell"
        }
      ]
    },
    {
      "type": "Collection",
      "id": "cg_route_auto_class",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{keyedRows}",
      "cellIdProperty": "key",
      "autoChangeTrackingId": true,
      "scrollTo": "@{autoKey}",
      "scrollAnchor": "top",
      "scrollAnimated": false,
      "cellClasses": [
        "conformance_cell"
      ]
    },
    {
      "type": "Collection",
      "id": "cg_route_auto_pager",
      "width": 200,
      "height": 40,
      "background": "#DDDDDD",
      "items": "@{keyedRows}",
      "cellIdProperty": "key",
      "autoChangeTrackingId": true,
      "scrollTo": "@{autoKey}",
      "scrollAnchor": "top",
      "scrollAnimated": false,
      "sections": [
        {
          "cell": "conformance_cell"
        },
        {
          "cell": "conformance_cell"
        }
      ],
      "layout": "horizontal",
      "paging": true
    },
    {
      "type": "Button",
      "id": "cg_route_go_cellid2_c2",
      "text": "cg cellid2 go c2",
      "onClick": "@{onCellIdC2}"
    },
    {
      "type": "Button",
      "id": "cg_route_go_cellid2_13",
      "text": "cg cellid2 go 1:3",
      "onClick": "@{onCellId13}"
    },
    {
      "type": "Button",
      "id": "cg_route_go_cellid2_e4",
      "text": "cg cellid2 go e4",
      "onClick": "@{onCellIdE4}"
    },
    {
      "type": "Collection",
      "id": "cg_route_cellid2",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{cellIdRows}",
      "sections": [
        {
          "cell": "conformance_cell"
        },
        {
          "cell": "conformance_cell"
        }
      ],
      "scrollTo": "@{cellIdKey}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    }
  ],
