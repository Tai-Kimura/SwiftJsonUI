{
  "type": "View",
  "id": "cg_route2_root",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "wrapContent",
  "child": [
    {
      "type": "Button",
      "id": "cg_route_go_class",
      "text": "cg class go 6",
      "onClick": "@{onClassIndex}"
    },
    {
      "type": "Collection",
      "id": "cg_route_class",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{classRows}",
      "cellClasses": [
        "conformance_cell"
      ],
      "scrollTo": "@{classIndex}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    },
    {
      "type": "Button",
      "id": "cg_route_go_class_key",
      "text": "cg class go k3",
      "onClick": "@{onClassKey}"
    },
    {
      "type": "Collection",
      "id": "cg_route_class_key",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{classKeyed}",
      "cellClasses": [
        "conformance_cell"
      ],
      "cellIdProperty": "key",
      "scrollTo": "@{classKey}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    },
    {
      "type": "Button",
      "id": "cg_route_go_pager",
      "text": "cg pager go 6",
      "onClick": "@{onPagerIndex}"
    },
    {
      "type": "Collection",
      "id": "cg_route_pager",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{ruleRows}",
      "sections": [
        {
          "cell": "conformance_cell"
        },
        {
          "cell": "conformance_cell"
        }
      ],
      "layout": "horizontal",
      "paging": true,
      "scrollTo": "@{pagerIndex}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    },
    {
      "type": "Button",
      "id": "cg_route_go_pager_key",
      "text": "cg pager go k3",
      "onClick": "@{onPagerKey}"
    },
    {
      "type": "Collection",
      "id": "cg_route_pager_key",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{ruleKeyed}",
      "sections": [
        {
          "cell": "conformance_cell"
        },
        {
          "cell": "conformance_cell"
        }
      ],
      "layout": "horizontal",
      "paging": true,
      "cellIdProperty": "key",
      "scrollTo": "@{pagerKey}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    },
    {
      "type": "Button",
      "id": "cg_route_go_cellid",
      "text": "cg cellid go c3",
      "onClick": "@{onCellIdKey}"
    },
    {
      "type": "Collection",
      "id": "cg_route_cellid",
      "width": 200,
      "height": 84,
      "background": "#DDDDDD",
      "items": "@{ruleCellIds}",
      "sections": [
        {
          "cell": "conformance_cell"
        },
        {
          "cell": "conformance_cell"
        }
      ],
      "scrollTo": "@{cellIdKey}",
      "scrollAnchor": "top",
      "scrollAnimated": false
    }
  ],
