    {
      "type": "View",
      "id": "wrap_cg_view",
      "orientation": "vertical",
      "width": "matchParent",
      "height": "wrapContent",
      "child": [
        {
          "type": "View",
          "id": "cg_view",
          "orientation": "vertical",
          "child": [
            {
              "type": "Label",
              "id": "cg_view_kid",
              "text": "View kid"
            }
          ]
        }
      ]
    }
