      "width": 300,
      "height": 120,
      "background": "#FFFFFF",
      "child": [
        {
          "type": "Collection",
          "id": "cg_rc_lazy_wrap",
          "layout": "horizontal",
          "background": "#CCE0FF",
          "items": "@{ten}",
          "sections": [
            {
              "cell": "conformance_cell"
            }
          ],
          "width": "matchParent"
        },
        {
          "type": "Label",
          "id": "cg_rc_lazy_wrap_after",
          "text": "after",
          "width": "wrapContent",
          "height": "wrapContent"
        }
      ]
    },
    {
