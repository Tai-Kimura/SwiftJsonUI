    {
      "name": "\"…\" with JSON's escapes",
      "spelling": "\"a\\nb \\\"hi\\\" \\\\ \\u00e9 \\/ \\t\"",
      "text": "a\nb \"hi\" \\ é / \t"
    },
    {
      "name": "\"…\" with an escape JSON does not have",
      "spelling": "\"C:\\new \\(t)\"",
