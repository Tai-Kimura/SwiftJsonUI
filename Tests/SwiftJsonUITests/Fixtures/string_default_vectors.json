      "text": ""
    },
    {
      "name": "\"…\"",
      "spelling": "\"Test\"",
      "text": "Test"
    },
    {
      "name": "\"…\" with no escape",
      "spelling": "\"Pay $x ${y} `b` {c} it's\"",
      "text": "Pay $x ${y} `b` {c} it's"
