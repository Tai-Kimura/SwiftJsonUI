      "defaultValue": {
        "typescript": "t"
      },
      "expect": {
        "swift": "",
        "kotlin": "",
        "typescript": "t"
      },
      "warnFor": [
        "swift",
        "kotlin"
      ]
    },
    {
      "name": "String spellings inside a platform dictionary",
      "class": "String",
      "defaultValue": {
