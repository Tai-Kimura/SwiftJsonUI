{
  "_description": "The tap shapes shared/core/tap_accessibility.rb assigns — the table the sjui and kjui codegen and the SwiftJsonUI / KotlinJsonUI Dynamic runtimes all run (the libraries from byte-identical copies). `shapes` maps an id to button / combine / none, or null for a node that is not a tappable. A node with `userInteractionEnabled: false`, and every node inside it, is no tappable (as `canTap: false`); a bound one keeps its shape, and the emitters gate the tap and its trait on the binding. `interactive_types` and `known_types` are component_metadata.json's `interactive` declaration with its aliases, pinned to it by sjui_tools/spec/core/tap_accessibility_spec.rb.",
  "interactive_types": [
    "Button",
    "Check",
    "CheckBox",
    "Checkbox",
    "Collection",
    "EditText",
    "Embed",
    "Input",
    "Radio",
    "RecyclerView",
    "ScrollView",
    "Segment",
    "SelectBox",
    "Slider",
    "Switch",
    "TabView",
    "Table",
    "TableView",
    "TextField",
    "TextView",
    "Toggle",
    "Web"
  ],
  "known_types": [
    "Blur",
    "Button",
    "Check",
    "CheckBox",
    "Checkbox",
    "CircleImage",
    "CircleImageView",
    "CircleView",
    "Collection",
