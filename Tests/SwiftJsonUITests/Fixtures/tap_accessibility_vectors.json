    "SafeAreaView",
    "ScrollView",
    "Segment",
    "SelectBox",
    "Slider",
    "Switch",
    "TabView",
    "Table",
    "TableView",
    "Text",
    "TextField",
    "TextView",
    "Toggle",
    "View",
    "Web"
  ],
  "controls": {
    "_description": "Which nodes are controls — shared/core/tap_accessibility.rb `control?`: a declared interactive type, asked of the type the node is drawn as (TypeSynonyms.drawn_type: a synonym's target, an alias's section), that is not a container of operated things (`stop_container_types`, drawn types only); an app's own spelling (`app_types`, the types the app registers as components of its own) is none, whatever it spells. The sjui and kjui codegen and both Dynamic runtimes (TapAccessibility.isControl) answer each case alike.",
    "stop_container_types": [
      "Collection",
      "Embed",
      "ScrollView",
      "TabView",
      "Web"
    ],
